# =============================================================================
# Standard Configuration
# These variables control runtime behavior and are safe to share/commit.
# =============================================================================

# Runtime environment: "production" or "development"
NODE_ENV=production

# Port the application listens on (nginx serves on this port inside the container)
PORT=3000

# Public-facing base URL of the application (used for absolute links, CORS, etc.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# =============================================================================
# Sensitive Credentials — DO NOT commit real values!
# These are placeholders only. In production, inject via Kubernetes Secrets
# backed by HashiCorp Vault through ExternalSecrets (see k8s/secrets-template.yaml).
# =============================================================================

# PostgreSQL connection string (used by the backend API layer)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/db?sslmode=require

# Secret key for signing JWTs / session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-here

# API secret key for service-to-service authentication
API_SECRET_KEY=your-api-secret-key-here

# Individual database connection parameters (optional — DATABASE_URL takes precedence)
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=changeme
DB_NAME=db
